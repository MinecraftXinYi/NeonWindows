	<PropertyGroup>
		<AssemblyTitle>NeonWindows Modern App Core Library for Modern .NET</AssemblyTitle>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\NeonWinModernCoreI\NeonWinModernCoreI.csproj" />
	</ItemGroup>
</Project>
