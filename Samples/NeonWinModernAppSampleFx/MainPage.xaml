<Page
  x:Class="NeonWinModernAppSampleFx.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">

    <Page.Background>
        <AcrylicBrush BackgroundSource="HostBackdrop" TintOpacity="0" />
    </Page.Background>

    <StackPanel
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Orientation="Vertical">
        <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="Hello, world." IsTextSelectionEnabled="True" />
        <TextBlock Text="{x:Bind FrameworkDescription}" />
        <TextBox />
        <Button Click="Button_Click">Click Me</Button>
    </StackPanel>
</Page>
